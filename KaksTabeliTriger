CREATE TRIGGER trgiger_opilane_lisa
ON opilased
FOR INSERT
AS
BEGIN
    INSERT INTO logi (tegevus, kasutaja)
    SELECT 'lisatud: ' + nimi, USER_NAME()
    FROM inserted;
END;



CREATE TRIGGER trg_opilane_kustuta
ON opilased
FOR DELETE
AS
BEGIN
    INSERT INTO logi (tegevus, kasutaja)
    SELECT 'kustutatud: ' + nimi, USER_NAME()
    FROM deleted;
END;


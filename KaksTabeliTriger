CREATE TABLE kursused (
kursusID INT IDENTITY(1,1) PRIMARY KEY,
kursuseNimi VARCHAR(50),
opilaneID INT,
FOREIGN KEY (opilaneID) REFERENCES opilased(opilaneID)
);


CREATE TRIGGER trg_kursus_lisa
ON kursused
FOR INSERT
AS
BEGIN
    INSERT INTO logi (tegevus, kasutaja)
    SELECT 'Lisati kursus: ' + kursuseNimi, USER_NAME()
    FROM inserted;
END;




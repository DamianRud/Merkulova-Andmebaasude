CREATE DATABASE opilased; 
USE opilased; 


CREATE TABLE opilased (
opilaneID INT IDENTITY(1,1) PRIMARY KEY,
nimi VARCHAR(100),
vanus INT,
klass VARCHAR(10)
); 


CREATE TABLE logi (
logiID INT IDENTITY(1,1) PRIMARY KEY,
kuupaev DATETIME DEFAULT GETDATE(),
tegevus VARCHAR(255),
kasutaja VARCHAR(100)
); 



CREATE TABLE logi (
logi_id    INT IDENTITY(1,1) PRIMARY KEY,
kuupäev    DATETIME DEFAULT GETDATE(),
tegevus    VARCHAR(255),
kasutaja   VARCHAR(100)
);


CREATE TABLE hinded (
hinneID INT IDENTITY(1,1) PRIMARY KEY,
opilase_id INT FOREIGN KEY REFERENCES oppilased(oppilase_id),
aine VARCHAR(50),
hinne INT,
kuupaev DATE
);


CREATE TRIGGER oppilaneListamine
ON oppilased
FOR INSERT
AS
INSERT INTO logi(kuupäev, tegevus)
SELECT
GETDATE(),
'Lisati uus õpilane: ' + inserted.nimi
FROM inserted;

CREATE TRIGGER oppilaneKustutamine
ON oppilased
FOR DELETE
AS
INSERT INTO logi(kuupäev, tegevus)
SELECT
GETDATE(),
'Kustutati õpilane: ' + deleted.nimi
FROM deleted;


CREATE TRIGGER oppilaseLisamine
ON oppilased 
FOR INSERT
AS
INSERT INTO logi(kuupäev, tegevus, kasutaja)
SELECT
GETDATE(),               
'on tehtud INSERT käsk', 
CONCAT(inserted.nimi, ' (Kasutaja: ', SYSTEM_USER, ')')
FROM inserted;


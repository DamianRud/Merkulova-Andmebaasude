CREATE TRIGGER oppilaseKustutamine
ON oppilased 
FOR DELETE
AS
INSERT INTO logi(kuupäev, tegevus, kasutaja)
SELECT
GETDATE(),               
'on tehtud DELETE käsk', 
CONCAT(
'õpilane: ', deleted.nimi, 
', vanus: ', deleted.vanus, 
', klass: ', deleted.klass, 
' (Kasutaja: ', SYSTEM_USER, ')' 
) 
FROM deleted;





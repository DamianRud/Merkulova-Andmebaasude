-- view mis näitab lapsi kellek on rohkem kui 1 loom

SELECT * sisestatud_lapsiloomad;

CREATE VIEW sisestatud_lapsiloomad AS 
SELECT l.nimi AS lapsNimi,Count(lm.nimi) AS loomNimi
FROM laps l INNER JOIN loom lm
ON l.lapsID=lm.lapsID
GROUP BY l.nimi;
HAVING Count(l.nimi)>1;

SELECT * FROM sisestatud_lapsiloomad;



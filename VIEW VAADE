CREATE DATABASE ViewVaade;
Use ViewVaade;



CREATE TABLE laps(
    lapsID INT NOT NULL PRIMARY KEY identity,
    nimi VARCHAR(40) NOT NULL,
    pikkus SMALLINT,
    synniaasta INT NULL,
    synnilinn VARCHAR(15)
);



CREATE TABLE loom(
    loomID INT NOT NULL PRIMARY KEY identity,
    nimi VARCHAR(40) NOT NULL,
    kaal SMALLINT,
    lapsID INT,
    FOREIGN KEY (lapsID) REFERENCES laps(lapsID)
);



create database Tellimused;



CREATE TABLE [Klient] (
  [klientID] INT,
  [KlientNimi] Varchar(30) not null,
  PRIMARY KEY ([klientID])
);

CREATE TABLE [Aadress] (
  [AadresID] int,
  [aadres] varchar(30),
  [klientID] int,
  PRIMARY KEY ([AadresID]),
  CONSTRAINT [FK_Aadress_klientID]
    FOREIGN KEY ([klientID])
      REFERENCES [Klient]([klientID])
);



CREATE TABLE [kommid] (
  [KommitypeID] int,
  [kommitüüp] varchar(30),
  [Field] varchar(50),
  PRIMARY KEY ([KommitypeID])
);

CREATE TABLE [komm] (
  [KommID] INT,
  [Hind] INT,
  [KehtivID] INT,
  [KommNimetus] varchar(30),
  [KommitypID] INT,
  PRIMARY KEY ([KommID]),
  CONSTRAINT [FK_komm_KommitypID]
    FOREIGN KEY ([KommitypID])
      REFERENCES [kommid]([KommitypeID])
);

CREATE TABLE [Kehtivus] (
  [KehtivID] INT,
  [Kehtivusaeg] DATE,
  [Field] varchar(30),
  PRIMARY KEY ([KehtivID])
);

CREATE TABLE [Pakkija] (
    [Pakkijad] INT,
    [Pakkijanimi] Varchar(30),
    [Pakkijaperenimi] varchar(30),
    PRIMARY KEY ([Pakkijad])
);

CREATE TABLE [Tellimused] (
  [TellimuseID] INT,
  [aadresID] INT,
  [KommiD] INT,
  [Kogus] varchar(30),
  [PakkijadID] INT,
  [Tellimusekuupäev] DATE,
  PRIMARY KEY ([TellimuseID]),
  CONSTRAINT [FK_Tellimused_KommiD]
    FOREIGN KEY ([KommiD])
      REFERENCES [komm]([KommID]),
  CONSTRAINT [FK_Tellimused_aadresID]
    FOREIGN KEY ([aadresID])
      REFERENCES [Aadress]([AadresID]),
  CONSTRAINT [FK_Tellimused_PakkijadID]
    FOREIGN KEY ([PakkijadID])
      REFERENCES [Pakkija]([Pakkijad])
);



USE Tellimused;
GO



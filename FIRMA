CREATE VIEW v_Ettevotte_Kohad AS
SELECT f.firmanimi, COUNT(b.praktikabaasID) AS kohtade_arv
FROM firma f
LEFT JOIN praktikabaas b ON f.firmaID = b.firmaID
GROUP BY f.firmanimi;



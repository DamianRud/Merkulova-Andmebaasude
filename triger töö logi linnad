--triger mis jälgib andmete uuendamine kahes tabelis 
CREATE OR ALTER TRIGGER LinnaUuendamine
ON linnad
FOR UPDATE
AS
BEGIN
INSERT INTO logi(kuupaev, andmed, kasutaja)
SELECT 
GETDATE(), 
CONCAT(
'MUUTMINE. ',
'Vana: ', d.linnanimi, ' (rahvaarv: ', d.rahvaarv, ', maakond: ', m1.maakondNimi, '). ',
'Uus: ', i.linnanimi, ' (rahvaarv: ', i.rahvaarv, ', maakond: ', m2.maakondNimi, ')'
),
USER_NAME()
FROM deleted d
INNER JOIN inserted i ON d.linnId = i.linnId 
INNER JOIN maakonnad m1 ON d.maakondId = m1.maakondId 
INNER JOIN maakonnad m2 ON i.maakondId = m2.maakondId;
END;


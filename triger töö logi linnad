CREATE TRIGGER LinnaKustutamine
ON Linnad
FOR DELETE
AS
BEGIN
INSERT INTO logi(kuupaev, andmed, kasutaja)
SELECT 
GETDATE(), 
CONCAT(
'Kustutatud linn: ', d.linnanimi, 
', rahvaarv: ', d.rahvaarv, 
', maakond: ', m.maakondNimi 
),
USER_NAME()
FROM deleted d
INNER JOIN maakonnad m ON d.maakondId = m.maakondId;
END;


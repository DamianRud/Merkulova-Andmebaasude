--triger mis jälgib kaks seostatud tabelid
ALTER TRIGGER LinnaLisamine
ON linnad 
for INSERT 
AS
BEGIN
INSERT INTO logi(kuupaev, andmed, kasutaja)
SELECT 
GETDATE(), 
CONCAT('Lisatud linn: ', i.linnanimi, ', rahvaarv: ', i.rahvaarv),
USER_NAME() 
FROM inserted i;
END;


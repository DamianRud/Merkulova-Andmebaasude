CREATE TRIGGER trgLisa
ON Auto
AFTER INSERT
AS
BEGIN
INSERT INTO autologi(tegevus, aeg)
VALUES ('Auto on lisatud', GETDATE());
END;


CREATE TRIGGER trgKustuta
ON Auto
AFTER DELETE
AS
BEGIN
INSERT INTO autologi(tegevus, aeg)
VALUES ('Auto on kustutatud', GETDATE());
END;


CREATE TRIGGER trgUuenda
ON Auto
AFTER UPDATE
AS
BEGIN
INSERT INTO autologi(tegevus, aeg)
VALUES ('Auto andmed on muudetud', GETDATE());
END;

